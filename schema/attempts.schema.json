{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andyleehsa.github.io/japanese-log/schema/attempts.schema.json",
  "title": "Monthly attempt log",
  "description": "logs/attempts/YYYY-MM.json written by the app. Append-only merge by attempt id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "month", "attempts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "attempts": {
      "type": "array",
      "items": { "$ref": "#/$defs/attempt" }
    }
  },
  "$defs": {
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "questionId", "lessonId", "tags", "userAnswer", "correct", "timestamp", "localDate", "attemptNo"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "questionId": { "type": "string", "minLength": 1 },
        "lessonId": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "userAnswer": { "type": "string" },
        "correct": { "type": "boolean" },
        "timestamp": { "type": "string", "description": "ISO-8601 with the device's local offset." },
        "localDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "attemptNo": { "type": "integer", "minimum": 1 },
        "review": { "type": "boolean", "description": "True when the attempt came from the spaced review session. Omitted on ordinary practice." }
      }
    }
  }
}
