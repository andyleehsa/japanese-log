{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andyleehsa.github.io/japanese-log/schema/vocab.schema.json",
  "title": "Vocabulary bank for one JLPT level",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "level", "categories"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "level": { "enum": ["N5", "N4", "N3"] },
    "sample": { "type": "boolean" },
    "categories": {
      "type": "array",
      "items": { "$ref": "#/$defs/category" }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "entries"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "japanese", "reading", "meaning", "level", "category"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "japanese": { "type": "string", "minLength": 1 },
        "reading": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "minLength": 1 },
        "level": { "enum": ["N5", "N4", "N3"] },
        "category": { "type": "string" },
        "example": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jp", "reading", "zh"],
          "properties": {
            "jp": { "type": "string", "minLength": 1 },
            "reading": { "type": "string", "minLength": 1 },
            "zh": { "type": "string", "minLength": 1 },
            "verified": { "type": "boolean" }
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "speak": { "type": "string", "minLength": 1 },
        "verbGroup": { "enum": ["一類", "二類", "三類"] },
        "forms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ます形", "て形", "ない形", "た形"],
          "properties": {
            "ます形": { "$ref": "#/$defs/verbForm" },
            "て形": { "$ref": "#/$defs/verbForm" },
            "ない形": { "$ref": "#/$defs/verbForm" },
            "た形": { "$ref": "#/$defs/verbForm" }
          }
        }
      }
    },
    "verbForm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["japanese", "reading"],
      "properties": {
        "japanese": { "type": "string", "minLength": 1 },
        "reading": { "type": "string", "minLength": 1 }
      }
    }
  }
}
