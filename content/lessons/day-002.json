        { "word": "あれ", "reading": "あれ", "meaning": "嗰個（離雙方都遠）", "speak": "あれ" },
        { "word": "この", "reading": "この", "meaning": "呢個 + 名詞", "speak": "この" },
        { "word": "水", "reading": "みず", "meaning": "水", "speak": "みず" },
        { "word": "学校", "reading": "がっこう", "meaning": "學校", "speak": "がっこう" }
      ]
    },
    {
      "type": "example",
      "jp": "これは水です。",
      "reading": "これは みずです。",
      "zh": "呢個係水。",
      "speak": "これは水です。",
